VPATH=include:include/stack:include/queue:include/bitree:src:src/stack:src/queue:src/bitree

src_dir=./src
src_stack=./src/stack
src_queue=./src/queue
src_bitree=./src/bitree

header_prerequisites=SqList.h ForwardList.h String.h Stack.h StackImpl2.h \
SharedStack.h Queue.h QueueImpl2.h QueueImpl3.h LinkQueue.h ReusableLinkQueue.h BiTree.h BiTree.h

obj_prerequisites=SqList.o ForwardList.o String.o Stack.o StackImpl2.o SharedStack.o Queue.o \
QueueImpl2.o QueueImpl3.o LinkQueue.o ReusableLinkQueue.o BiTree.o BstTree.o Startup.o


startup : $(obj_prerequisites)
# 链接，生成可执行文件
	gcc -o startup $(obj_prerequisites)

SqList.o : SqList.h SqList.c
	gcc -c $(src_dir)/SqList.c
ForwardList.o : ForwardList.h
	gcc -c $(src_dir)/ForwardList.c
String.o : String.h
	gcc -c $(src_dir)/String.c
	
Stack.o : Stack.h BiTree.h
	gcc -c $(src_stack)/Stack.c
StackImpl2.o : StackImpl2.h
	gcc -c $(src_stack)/StackImpl2.c
SharedStack.o : SharedStack.h
	gcc -c $(src_stack)/SharedStack.c

Queue.o : Queue.h
	gcc -c $(src_queue)/Queue.c
QueueImpl2.o : QueueImpl2.h
	gcc -c $(src_queue)/QueueImpl2.c
QueueImpl3.o : QueueImpl3.h
	gcc -c $(src_queue)/QueueImpl3.c
LinkQueue.o : LinkQueue.h
	gcc -c $(src_queue)/LinkQueue.c
ReusableLinkQueue.o : ReusableLinkQueue.h BiTree.h
	gcc -c $(src_queue)/ReusableLinkQueue.c
	
BiTree.o : BiTree.h Stack.h ReusableLinkQueue.h
	gcc -c $(src_bitree)/BiTree.c
BstTree.o : BiTree.h BstTree.h
	gcc -c $(src_bitree)/BstTree.c
	
Startup.o : $(header_prerequisites)
	gcc -c $(src_dir)/Startup.c
	
.PHONE : clean
clean:
	rm -rf *.o startup.exe